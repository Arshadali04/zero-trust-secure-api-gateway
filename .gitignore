# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ── Distribution / packaging ─────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
MANIFEST
wheels/
sdist/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment variables / secrets ──────────────────────────────────────────
.env
.env.*
!.env.example
.env.oauth

# ── Database & runtime data ───────────────────────────────────────────────────
data/*.db
data/logs/
data/geoip/*.mmdb
data/models/          # ML model files (joblib .pkl) — generated at runtime
*.sqlite3
*.sqlite
*.db

# ── TLS certificates (place in nginx/certs/ — never commit private keys) ─────
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/*.crt
nginx/certs/*.p12

# ── IDE & editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Testing & coverage ───────────────────────────────────────────────────────
.coverage
.coverage.*
.pytest_cache/
htmlcov/
coverage.xml
*.cover

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Type checkers / linters ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.dmypy.json
.pytype/
.pyre/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Build artifacts ───────────────────────────────────────────────────────────
*.manifest
*.spec
site/

# ── Docs / presentation materials (local only, not tracked in git) ────────────
docs/
.env.example